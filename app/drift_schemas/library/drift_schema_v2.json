  "fixed_sql": [
    {
      "name": "tag_templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tag_templates\" (\"id\" TEXT NOT NULL, \"name\" TEXT NULL, \"sport\" TEXT NOT NULL, \"built_in\" INTEGER NOT NULL DEFAULT 0 CHECK (\"built_in\" IN (0, 1)), \"schema_version\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"template_id\" TEXT NULL REFERENCES tag_templates (id) ON DELETE SET NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"template_id\" TEXT NOT NULL REFERENCES tag_templates (id) ON DELETE CASCADE, \"name\" TEXT NULL, \"color\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "clips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clips\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"request_id\" TEXT NULL, \"camera_id\" TEXT NULL, \"requested_at\" INTEGER NOT NULL, \"camera_time\" INTEGER NULL, \"duration_ms\" INTEGER NULL, \"file_path\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"sha256\" TEXT NULL, \"title\" TEXT NULL, \"notes\" TEXT NULL, \"trim_start_ms\" INTEGER NULL, \"trim_end_ms\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "clip_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clip_tags\" (\"clip_id\" TEXT NOT NULL REFERENCES clips (id) ON DELETE CASCADE, \"tag_id\" TEXT NOT NULL, PRIMARY KEY (\"clip_id\", \"tag_id\"));"
        }
      ]
    }
